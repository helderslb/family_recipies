---
import Layout from '@/layouts/Layout.astro';
import T from '@/components/T.astro';
import { translate } from '@/i18n/ui';

const messages = {
  error: { en: translate('en', 'login.error'), pt: translate('pt', 'login.error') },
  signedOut: { en: translate('en', 'admin.signedOut'), pt: translate('pt', 'admin.signedOut') },
};
---

<Layout
  title={translate('en', 'login.title')}
  titlePt={translate('pt', 'login.title')}
  description={translate('en', 'login.subtitle')}
  descriptionPt={translate('pt', 'login.subtitle')}
>
  <section class="border-b border-oatmeal/60 bg-page-glow">
    <div class="container-max py-14 md:py-20">
      <div class="mx-auto w-full max-w-md">
        <div class="flex items-center gap-3">
          <span
            class="flex h-11 w-11 items-center justify-center rounded-2xl bg-ink text-cream shadow-soft"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </span>
          <p class="eyebrow"><T k="login.eyebrow" /></p>
        </div>

        <h1 class="mt-5 text-3xl leading-tight md:text-4xl"><T k="login.title" /></h1>
        <p class="mt-3 text-sm text-ink-light"><T k="login.subtitle" /></p>

        <form
          id="login-form"
          method="post"
          action="/api/auth/login"
          class="mt-8 rounded-3xl border border-oatmeal bg-white p-6 shadow-soft md:p-8"
        >
          <input type="hidden" id="login-next" name="next" value="/admin" />

          <div>
            <label for="username" class="label"><T k="common.username" /></label>
            <input
              id="username"
              name="username"
              type="text"
              autocomplete="username"
              class="input"
              required
              autofocus
            />
          </div>

          <div class="mt-4">
            <label for="password" class="label"><T k="common.password" /></label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              class="input"
              required
            />
          </div>

          <p
            id="login-error"
            class="status-note status-error mt-4 hidden"
            role="alert"
            data-error-en={messages.error.en}
            data-error-pt={messages.error.pt}
          ></p>

          <button type="submit" class="btn mt-6 w-full"><T k="login.submit" /></button>

          <p class="mt-4 text-center text-xs text-ink-lighter"><T k="login.devNotice" /></p>
        </form>

        <a
          href="/"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink-lighter transition-colors hover:text-terracotta-dark"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m6 6-6-6 6-6"></path>
          </svg>
          <T k="login.back" />
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ messages }}>
    (function () {
      const form = document.getElementById('login-form');
      const nextInput = document.getElementById('login-next');
      const errorBox = document.getElementById('login-error');
      const params = new URLSearchParams(window.location.search);
      const next = params.get('next');
      const safeNext = next && next.charAt(0) === '/' && next.charAt(1) !== '/' ? next : '/admin';

      if (nextInput) nextInput.value = safeNext;

      function lang() {
        return document.documentElement.getAttribute('data-lang') === 'pt' ? 'pt' : 'en';
      }

      function showError(key) {
        if (!errorBox) return;
        const entry = messages[key] || messages.error;
        errorBox.setAttribute('data-error-en', entry.en);
        errorBox.setAttribute('data-error-pt', entry.pt);
        errorBox.textContent = entry[lang()] || entry.en;
        errorBox.classList.remove('hidden');
      }

      if (params.get('error')) showError('error');
      if (params.get('signedout')) showError('signedOut');

      document.addEventListener('languagechange', function () {
        if (errorBox && !errorBox.classList.contains('hidden')) {
          const text = errorBox.getAttribute('data-error-' + lang());
          if (text) errorBox.textContent = text;
        }
      });

      // Already signed in? Go straight to the admin area.
      if (typeof window.fetch === 'function') {
        window
          .fetch('/api/auth/session', { headers: { Accept: 'application/json' } })
          .then(function (response) {
            return response.ok ? response.json() : null;
          })
          .then(function (data) {
            if (data && data.authenticated && form) {
              window.location.replace(safeNext);
            }
          })
          .catch(function () {
            /* the form still works when the API is reachable on submit */
          });
      }
    })();
  </script>
</Layout>
