---
import Layout from '@/layouts/Layout.astro';
import T from '@/components/T.astro';
import { translate } from '@/i18n/ui';
import { restaurants } from '@/lib/restaurants';

const mapData = {
  places: restaurants,
  labels: {
    rating: { en: translate('en', 'restaurants.rating'), pt: translate('pt', 'restaurants.rating') },
    quality: { en: translate('en', 'restaurants.quality'), pt: translate('pt', 'restaurants.quality') },
    ambience: { en: translate('en', 'restaurants.ambience'), pt: translate('pt', 'restaurants.ambience') },
    price: { en: translate('en', 'restaurants.price'), pt: translate('pt', 'restaurants.price') },
    notes: { en: translate('en', 'restaurants.notes'), pt: translate('pt', 'restaurants.notes') },
    saved: { en: translate('en', 'restaurants.saved'), pt: translate('pt', 'restaurants.saved') },
    visit: { en: translate('en', 'restaurants.visit'), pt: translate('pt', 'restaurants.visit') },
  },
};

const mapDataJson = JSON.stringify(mapData).replace(/</g, '\\u003c');
---

<Layout
  title={translate('en', 'restaurants.title')}
  titlePt={translate('pt', 'restaurants.title')}
  description={translate('en', 'restaurants.subtitle')}
  descriptionPt={translate('pt', 'restaurants.subtitle')}
>

  <section class="relative overflow-hidden bg-page-glow">
    <div class="container-max pb-8 pt-12 md:pt-16">
      <p class="eyebrow"><T k="restaurants.eyebrow" /></p>
      <h1 class="mt-4"><T k="restaurants.title" /></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-light"><T k="restaurants.subtitle" /></p>
      <p class="mt-5 text-sm font-semibold text-ink-lighter">
        <span class="text-terracotta-dark">{restaurants.length}</span> <T k="restaurants.count" />
      </p>
    </div>
  </section>

  <section class="container-max mt-10">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 class="section-title"><T k="restaurants.mapTitle" /></h2>
      <p class="text-sm text-ink-lighter"><T k="restaurants.mapHint" /></p>
    </div>
    <div id="map" class="map-canvas mt-5"></div>
  </section>

  <section class="container-max mt-16">
    <div class="border-t border-oatmeal pt-10">
      <p class="eyebrow"><T k="restaurants.eyebrow" /></p>
      <h2 class="section-title mt-1"><T k="restaurants.listTitle" /></h2>

      <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {restaurants.map((r) => (
          <article class="card flex flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-semibold leading-snug">{r.name}</h3>
              {r.rating && (
                <span class="badge shrink-0 border-oatmeal bg-cream text-ink-light">{r.rating} ★</span>
              )}
            </div>

            {(r.type || r.location) && (
              <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-terracotta-dark">
                {r.type && <span>{r.type}</span>}
                {r.type && r.location && <span aria-hidden="true">·</span>}
                {r.location && <span>{r.location}</span>}
              </p>
            )}

            {r.description && (
              <p class="mt-4 text-sm leading-relaxed text-ink-light">{r.description}</p>
            )}

            {(r.qualityPrice || r.ambience || r.price || r.notes) && (
              <dl class="mt-4 space-y-2 border-t border-oatmeal pt-4 text-sm">
                {r.qualityPrice && (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter"><T k="restaurants.quality" /></dt>
                    <dd class="text-ink">{r.qualityPrice}</dd>
                  </div>
                )}
                {r.ambience && (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter"><T k="restaurants.ambience" /></dt>
                    <dd class="text-ink">{r.ambience}</dd>
                  </div>
                )}
                {r.price && (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter"><T k="restaurants.price" /></dt>
                    <dd class="text-ink">{r.price}</dd>
                  </div>
                )}
                {r.notes && (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter"><T k="restaurants.notes" /></dt>
                    <dd class="text-ink">{r.notes}</dd>
                  </div>
                )}
              </dl>
            )}

            {r.link && (
              <a
                href={r.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-terracotta-dark transition-colors hover:text-terracotta"
              >
                <T k="restaurants.visit" />
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M8 7h9v9"></path>
                </svg>
              </a>
            )}

            {r.date && (
              <p class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
                <T k="restaurants.saved" /> {r.date}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script id="restaurants-data" type="application/json" set:html={mapDataJson}></script>
  <script is:inline>
    (function () {
      var mapEl = document.getElementById('map');
      var dataEl = document.getElementById('restaurants-data');
      if (!mapEl || !dataEl || typeof L === 'undefined') return;

      var data;
      try {
        data = JSON.parse(dataEl.textContent || '{}');
      } catch (error) {
        return;
      }

      var labels = data.labels || {};
      var places = (data.places || []).filter(function (p) {
        return p && typeof p.lat === 'number' && typeof p.lng === 'number' && (p.lat || p.lng);
      });
      if (!places.length) return;

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function bilingual(label) {
        return (
          '<span data-lang="en">' + esc(label && label.en) + '</span>' +
          '<span data-lang="pt">' + esc(label && label.pt) + '</span>'
        );
      }

      function row(label, value) {
        if (!value) return '';
        return (
          '<div class="map-popup-row"><dt>' + bilingual(label) + '</dt><dd>' + esc(value) + '</dd></div>'
        );
      }

      function popupHtml(p) {
        var html = '<div class="map-popup">';
        html += '<div class="map-popup-name">' + esc(p.name) + '</div>';

        var meta = [p.type, p.location].filter(Boolean).join(' · ');
        if (meta) html += '<div class="map-popup-meta">' + esc(meta) + '</div>';
        if (p.description) html += '<p class="map-popup-desc">' + esc(p.description) + '</p>';

        html += row(labels.rating, p.rating ? p.rating + ' ★' : '');
        html += row(labels.quality, p.qualityPrice);
        html += row(labels.price, p.price);
        html += row(labels.ambience, p.ambience);
        html += row(labels.notes, p.notes);
        if (p.date) html += row(labels.saved, p.date);
        if (p.link) {
          html +=
            '<a class="map-popup-link" href="' + esc(p.link) + '" target="_blank" rel="noopener noreferrer">' +
            bilingual(labels.visit) + '</a>';
        }
        html += '</div>';
        return html;
      }

      var pin = L.divIcon({
        className: 'map-pin',
        html: '',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });

      // Group restaurants that share the same coordinates so overlapping pins stay clickable.
      var groups = {};
      places.forEach(function (p) {
        var key = p.lat.toFixed(6) + ',' + p.lng.toFixed(6);
        (groups[key] = groups[key] || []).push(p);
      });

      var map = L.map(mapEl, { scrollWheelZoom: false });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);

      Object.keys(groups).forEach(function (key) {
        var list = groups[key];
        list.forEach(function (p, i) {
          var latLng;
          if (list.length === 1) {
            latLng = [p.lat, p.lng];
          } else {
            var angle = (Math.PI * 2 * i) / list.length;
            var radius = 0.003;
            latLng = [p.lat + radius * Math.sin(angle), p.lng + radius * Math.cos(angle)];
          }
          L.marker(latLng, { icon: pin }).addTo(map).bindPopup(popupHtml(p));
        });
      });

      var bounds = L.latLngBounds(places.map(function (p) { return [p.lat, p.lng]; }));
      map.fitBounds(bounds.pad(0.15), { maxZoom: 11 });

      window.setTimeout(function () {
        map.invalidateSize();
      }, 200);
    })();
  </script>
</Layout>