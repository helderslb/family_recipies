---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import T from '@/components/T.astro';
import { familyLabel, translate } from '@/i18n/ui';
import { bilingualRecipe, storyParagraphs } from '@/lib/recipes';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');

  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

export interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { data, slug } = recipe;
const { Content } = await recipe.render();

const text = bilingualRecipe(recipe);
const storyPtParagraphs = data.storyPt ? storyParagraphs(data.storyPt) : [];
const hasStory = Boolean(recipe.body && recipe.body.trim().length > 0);

const familyStyles: Record<string, string> = {
  Grandma: 'border-terracotta/25 bg-terracotta/10 text-terracotta-dark',
  Mom: 'border-sage/30 bg-sage/15 text-sage-dark',
  Family: 'border-warm/25 bg-warm/10 text-warm',
};

const videoEmbed = (() => {
  if (!data.video) return null;
  const match = data.video.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/
  );
  return match ? `https://www.youtube.com/embed/${match[1]}` : null;
})();

const isMp4 = Boolean(data.video && /\.mp4(\?.*)?$/i.test(data.video));

const allRecipes = await getCollection('recipes');

const score = (entry: CollectionEntry<'recipes'>) =>
  (entry.data.category === data.category ? 2 : 0) + (entry.data.family === data.family ? 1 : 0);

const related = allRecipes
  .filter((entry) => entry.slug !== slug)
  .sort((a, b) => score(b) - score(a))
  .slice(0, 3);
---

<Layout
  title={text.en.title}
  titlePt={text.pt.title}
  description={text.en.description}
  descriptionPt={text.pt.description}
>

  <article class="recipe-print">
    <div class="container-max pt-6 md:pt-8">
      <nav class="no-print mb-6 text-sm" aria-label="Breadcrumb">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-medium text-ink-lighter transition-colors hover:text-terracotta-dark"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m6 6-6-6 6-6"></path>
          </svg>
          <T k="recipe.breadcrumb" />
        </a>
      </nav>

      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-12">
        <div class="animate-fade-up">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge border-oatmeal bg-oatmeal/60 text-ink-light">
              <T k={`category.${data.category}`} />
            </span>
            <span class:list={['badge', familyStyles[data.family] ?? 'border-oatmeal bg-cream text-ink-light']}>
              <span data-lang="en">
                {familyLabel(data.family, 'en')} {translate('en', 'recipe.familySuffix')}
              </span>
              <span data-lang="pt">
                {translate('pt', 'recipe.familyPrefix')} {familyLabel(data.family, 'pt')}
              </span>
            </span>
          </div>

          <h1 class="mt-4">
            <span data-lang="en">{text.en.title}</span>
            <span data-lang="pt">{text.pt.title}</span>
          </h1>

          <p class="mt-4 max-w-xl font-serif text-lg italic leading-relaxed text-ink-light">
            <span data-lang="en">{text.en.description}</span>
            <span data-lang="pt">{text.pt.description}</span>
          </p>

          <p class="mt-3 text-sm text-ink-lighter">
            <T k="recipe.fromKitchen" />
            <span class="font-semibold text-ink">{data.author}</span>
          </p>

          <div class="no-print mt-7 flex flex-wrap gap-2">
            <span class="meta-pill">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <T k="recipe.prep" /> {data.prepTime}
            </span>
            <span class="meta-pill">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c1.2 3.2 4 4.3 4 7.5a4 4 0 11-8 0C8 7.3 10.8 6.2 12 3z"></path>
              </svg>
              <T k="recipe.cook" /> {data.cookTime}
            </span>
            <span class="meta-pill">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20a5 5 0 00-10 0m5-8a3 3 0 100-6 3 3 0 000 6z"></path>
              </svg>
              <T k="recipe.serves" /> {data.servings}
            </span>
          </div>

          <div class="no-print mt-8 flex flex-wrap items-center gap-3">
            <button type="button" id="print-btn" class="btn">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
              </svg>
              <T k="recipe.print" />
            </button>
            <a href="#ingredients" class="btn-outline"><T k="recipe.jump" /></a>
          </div>
        </div>

        <div class="relative animate-fade-in">
          <div class="overflow-hidden rounded-4xl border border-white/60 bg-oatmeal shadow-lift">
            <img
              src={data.image}
              alt={text.en.title}
              class="aspect-[4/3] w-full object-cover"
              loading="eager"
            />
          </div>

          <div class="absolute inset-x-4 bottom-4 flex flex-wrap items-center justify-between gap-2">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-cream/95 px-3.5 py-2 text-[11px] font-semibold uppercase tracking-wider text-ink shadow-soft backdrop-blur"
            >
              <svg class="h-3.5 w-3.5 text-terracotta-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              {data.totalTime} <T k="recipe.totalSuffix" />
            </span>
            <span class="rounded-full bg-cream/95 px-3.5 py-2 text-[11px] font-semibold uppercase tracking-wider text-ink shadow-soft backdrop-blur">
              {data.ingredients.length} <T k="recipe.ingredients" />
            </span>
          </div>
        </div>
      </div>
    </div>


    <div class="container-max mt-14 md:mt-16">
      {data.video && (
        <div class="print-hide mb-12 overflow-hidden rounded-3xl border border-oatmeal bg-ink shadow-soft">
          {videoEmbed ? (
            <div class="aspect-video">
              <iframe
                src={`${videoEmbed}?rel=0`}
                title={`${data.title} — ${translate('en', 'recipe.video')}`}
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowFullScreen
                loading="lazy"
              ></iframe>
            </div>
          ) : isMp4 ? (
            <video
              src={data.video}
              controls
              class="h-full w-full object-cover"
              poster={data.image}
            ></video>
          ) : null}
        </div>
      )}

      <div class="print-stack grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-12">
        <div class="space-y-12">
          {hasStory && (
            <section>
              <h2 class="section-title flex items-center gap-3">
                <span
                  class="flex h-9 w-9 items-center justify-center rounded-xl bg-terracotta/10 text-terracotta-dark"
                  aria-hidden="true"
                >
                  ❤
                </span>
                <T k="recipe.story" />
              </h2>
              <div
                class="prose-recipe mt-4 rounded-3xl border border-oatmeal bg-gradient-to-br from-white to-cream p-6 font-serif text-[16px] italic text-ink-light shadow-soft md:p-8"
              >
                {storyPtParagraphs.length > 0 ? (
                  <>
                    <div data-lang="en"><Content /></div>
                    <div data-lang="pt">
                      {storyPtParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                  </>
                ) : (
                  <Content />
                )}
              </div>
            </section>
          )}

          <section>
            <h2 class="section-title flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-sage/15 text-sage-dark"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"></path>
                </svg>
              </span>
              <T k="recipe.method" />
            </h2>

            <ol class="mt-6 space-y-5" id="steps-list">
              {text.en.steps.map((step, index) => (
                <li class="recipe-step flex gap-4">
                  <span
                    class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-oatmeal bg-white font-serif text-sm font-semibold text-terracotta-dark shadow-sm"
                  >
                    {index + 1}
                  </span>
                  <p class="pt-1 text-[15px] leading-relaxed text-ink-light">
                    <span data-lang="en">{step}</span>
                    <span data-lang="pt">{text.pt.steps[index] ?? step}</span>
                  </p>
                </li>
              ))}
            </ol>
          </section>
        </div>


        <aside class="space-y-5 lg:sticky lg:top-28">
          <div id="ingredients" class="rounded-3xl border border-oatmeal bg-white p-6 shadow-soft">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-serif text-xl font-semibold tracking-tight">
                <T k="recipe.ingredientsTitle" />
              </h2>
              <span class="badge border-oatmeal bg-cream text-ink-light">
                {data.ingredients.length}
              </span>
            </div>

            <ul class="mt-5 space-y-3" id="ingredients-list">
              {text.en.ingredients.map((ingredient, index) => (
                <li class="recipe-ingredient group flex items-start gap-3">
                  <input
                    type="checkbox"
                    id={`ingredient-${index + 1}`}
                    class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-oatmeal-dark accent-terracotta"
                  />
                  <label
                    for={`ingredient-${index + 1}`}
                    class="cursor-pointer select-none text-sm leading-relaxed text-ink-light transition-colors group-hover:text-ink"
                  >
                    <span data-lang="en">{ingredient}</span>
                    <span data-lang="pt">{text.pt.ingredients[index] ?? ingredient}</span>
                  </label>
                </li>
              ))}
            </ul>

            <p class="mt-5 border-t border-oatmeal pt-4 text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
              <T k="recipe.tick" />
            </p>
          </div>

          <dl class="space-y-3 rounded-3xl border border-oatmeal bg-cream/70 p-6">
            <div class="flex items-center justify-between gap-4">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
                <T k="recipe.prep" />
              </dt>
              <dd class="text-sm font-semibold text-ink">{data.prepTime}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
                <T k="recipe.cook" />
              </dt>
              <dd class="text-sm font-semibold text-ink">{data.cookTime}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
                <T k="recipe.total" />
              </dt>
              <dd class="text-sm font-semibold text-terracotta-dark">{data.totalTime}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 border-t border-ink/10 pt-3">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-lighter">
                <T k="recipe.serves" />
              </dt>
              <dd class="text-sm font-semibold text-ink">{data.servings}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </article>


  {related.length > 0 && (
    <section class="print-hide container-max mt-20">
      <div class="flex flex-wrap items-end justify-between gap-3 border-t border-oatmeal pt-10">
        <div>
          <p class="eyebrow"><T k="recipe.keepCooking" /></p>
          <h2 class="section-title mt-1"><T k="recipe.related" /></h2>
        </div>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta-dark transition-colors hover:text-terracotta"
        >
          <T k="recipe.viewAll" />
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {related.map((entry) => <RecipeCard recipe={entry} />)}
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      const printButton = document.getElementById('print-btn');
      if (printButton) {
        printButton.addEventListener('click', function () {
          window.print();
        });
      }

      const checkboxes = document.querySelectorAll('#ingredients-list input[type="checkbox"]');
      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          const item = checkbox.closest('.recipe-ingredient');
          if (item) item.classList.toggle('is-done', checkbox.checked);
        });
      });
    })();
  </script>

  <style>
    .recipe-ingredient.is-done label {
      text-decoration: line-through;
      opacity: 0.55;
    }

    .recipe-ingredient {
      transition: opacity 0.2s ease;
    }

    .recipe-ingredient.is-done {
      opacity: 0.75;
    }
  </style>
</Layout>

