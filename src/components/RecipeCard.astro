---
import type { CollectionEntry } from 'astro:content';
import T from '@/components/T.astro';
import { bilingualRecipe, recipeSearchText } from '@/lib/recipes';

export interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { data, slug } = recipe;
const href = `/recipes/${slug}/`;
const text = bilingualRecipe(recipe);

const familyStyles: Record<string, string> = {
  Grandma: 'border-terracotta/25 bg-terracotta/10 text-terracotta-dark',
  Mom: 'border-sage/30 bg-sage/15 text-sage-dark',
  Family: 'border-warm/25 bg-warm/10 text-warm',
};

const familyBadge = familyStyles[data.family] ?? 'border-oatmeal bg-cream/90 text-ink-light';
---

<article
  class="group card"
  data-recipe-card
  data-category={data.category}
  data-family={data.family}
  data-search-text={recipeSearchText(recipe)}
  data-slug={slug}
>
  <a
    href={href}
    class="relative block aspect-[4/3] overflow-hidden bg-oatmeal"
    data-aria-en={`View recipe: ${text.en.title}`}
    data-aria-pt={`Ver receita: ${text.pt.title}`}
    aria-label={`View recipe: ${text.en.title}`}
    tabindex="-1"
  >
    <img
      src={data.image}
      alt={text.en.title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>

    <span class:list={['badge absolute left-3 top-3', familyBadge]}>
      <T k={`family.${data.family}`} />
    </span>

    {data.featured && (
      <span class="badge absolute right-3 top-3 border-white/30 bg-ink/70 text-cream">
        <T k="card.featured" />
      </span>
    )}

    <span
      class="absolute bottom-3 left-3 inline-flex translate-y-2 items-center gap-1.5 rounded-full bg-cream/95 px-3.5 py-2 text-xs font-semibold text-ink opacity-0 shadow-soft transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
    >
      <T k="card.view" />
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </span>
  </a>

  <div class="flex flex-col gap-2.5 p-5">
    <div class="flex flex-wrap items-center gap-2 text-[10px] font-semibold uppercase tracking-widest text-ink-lighter">
      <T k={`category.${data.category}`} class="text-terracotta-dark" />
      <span class="h-1 w-1 rounded-full bg-ink-lighter/50" aria-hidden="true"></span>
      <span class="font-medium normal-case tracking-normal">
        <T k="card.by" /> {data.author}
      </span>
    </div>

    <h3 class="text-lg leading-snug md:text-xl">
      <a href={href} class="text-ink transition-colors duration-200 hover:text-terracotta-dark">
        <span data-lang="en">{text.en.title}</span>
        <span data-lang="pt">{text.pt.title}</span>
      </a>
    </h3>

    <p class="line-clamp-2 text-sm text-ink-light">
      <span data-lang="en">{text.en.description}</span>
      <span data-lang="pt">{text.pt.description}</span>
    </p>

    <div class="mt-1 flex items-center gap-3 border-t border-oatmeal/80 pt-3 text-xs text-ink-lighter">
      <span class="inline-flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {data.prepTime}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c1.2 3.2 4 4.3 4 7.5a4 4 0 11-8 0C8 7.3 10.8 6.2 12 3z"></path>
        </svg>
        {data.cookTime}
      </span>
      <span class="ml-auto inline-flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20a5 5 0 00-10 0m5-8a3 3 0 100-6 3 3 0 000 6z"></path>
        </svg>
        {data.servings}
      </span>
    </div>
  </div>
</article>
