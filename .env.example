# Copy this file to `.env` (gitignored) for local development,
# and set these same values as Vercel Environment Variables in production.

# ---------- Admin login ----------
# Change these before deploying. Generate a strong secret, e.g. in PowerShell:
#   -join ((1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }))
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ---------- Turso database (Path A) ----------
# https://turso.tech → create a database, then an API token.
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=

# ---------- Cloudinary ----------
# https://cloudinary.com → the "Cloud name" shown in the dashboard.
CLOUDINARY_CLOUD_NAME=

# ---------- Vercel (optional) ----------
# A Vercel Deploy Hook URL to trigger a republish after a recipe edit.
VERCEL_DEPLOY_HOOK=